{
  "name": "seismo-backend",
  "version": "1.0.0",
  "private": true,
  "description": "GraphQL Federation backend: gateway + countries/quakes subgraphs + data collector",
  "scripts": {
    "build": "tsc",
    "dev:countries": "tsx watch src/countries/index.ts",
    "dev:quakes": "tsx watch src/quakes/index.ts",
    "dev:gateway": "tsx watch src/gateway/index.ts",
    "collect": "tsx src/collector/index.ts --once"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@apollo/composition": "2.14.4",
    "@apollo/gateway": "2.14.4",
    "@apollo/server": "^5.5.2",
    "@apollo/subgraph": "2.14.4",
    "@as-integrations/express5": "^1.1.2",
    "@opentelemetry/auto-instrumentations-node": "^0.83.1",
    "dataloader": "^2.2.3",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "graphql": "^16.15.0",
    "graphql-depth-limit": "^1.1.0",
    "graphql-query-complexity": "^2.0.0",
    "pg": "^8.23.1",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/graphql-depth-limit": "^1.1.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9"
  }
}
